{
  "name": "gestion-boutique",
  "private": true,
  "version": "0.1.6",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=@gestion-boutique/web",
    "dev:desktop": "pnpm --filter @gestion-boutique/desktop tauri dev",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @gestion-boutique/desktop tauri build",
    "collect:releases": "node scripts/collect-releases.mjs",
    "android:sync": "node scripts/sync-android-overrides.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @gestion-boutique/database db:generate",
    "db:migrate": "pnpm --filter @gestion-boutique/database db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": ">=3.4.17",
      "shell-quote": ">=1.11.0",
      "fast-uri": ">=3.1.7",
      "nanoid@<3.3.18": ">=3.3.18",
      "source-map-js": ">=1.2.2",
      "brace-expansion@>=2.0.0 <3": ">=2.1.6",
      "brace-expansion@>=4.0.0": ">=5.0.11"
    }
  }
}
